{{-- Shared <head> for every page.

  Partials inherit the including page's scope, so a page declares only what is
  particular to it - `pageTitle`, `pageDescription`, `canonicalPath`, and
  optionally `jsonLd`, `ogType`, `noindex`, `articleMeta`, `productMeta`. The
  script below derives everything else from `canonicalPath`, so no page has to
  remember to wire up its own card, and none can wire up the wrong one. --}}
<script server>
import { cardFor, clampDescription, origin as seoOriginValue } from '../data/page-meta'

const seoPath = typeof canonicalPath !== 'undefined' ? String(canonicalPath) : '/'

/*
 * Clamped here rather than at each call site, so no page can ship a
 * description a scraper will cut mid-word. Product copy in particular runs to
 * four hundred characters, of which Google shows about a hundred and sixty.
 */
const seoDescription = clampDescription(String(typeof pageDescription !== 'undefined' ? pageDescription : ''))
const seoOrigin = seoOriginValue
const socialCard = cardFor(seoPath)

/*
 * Alt text for the card, not a repeat of the title. A screen reader announcing
 * a link preview gets told what the picture is; the title is already read out
 * beside it.
 */
const socialCardAlt = typeof ogImageAlt !== 'undefined' && ogImageAlt
  ? String(ogImageAlt)
  : 'rappid. running apparel, photographed mid-race'
</script>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ seoDescription }}">

{{-- The canonical, and every absolute URL below, is built off the origin this
  build actually serves (APP_URL), not the brand's domain. A canonical naming
  a host this deployment does not answer is worse than none. --}}
<link rel="canonical" href="{{ seoOrigin }}{{ canonicalPath }}">

{{-- Filtered pages are real, linkable states, but they are the same products
  in a different order: letting a crawler index every size-and-sort permutation
  spends the site's crawl budget on near-duplicates of a page that is already
  indexed. The page itself still passes link equity through. --}}
@if (typeof noindex !== 'undefined' && noindex)
  <meta name="robots" content="noindex, follow">
@else
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
@endif

<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#f4f4f2" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0b0b0b" media="(prefers-color-scheme: dark)">

<meta property="og:type" content="{{ typeof ogType !== 'undefined' ? ogType : 'website' }}">
<meta property="og:site_name" content="rappid.">
<meta property="og:locale" content="en_GB">
<meta property="og:url" content="{{ seoOrigin }}{{ canonicalPath }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ seoDescription }}">

{{-- Deliberately ONE og:image. Repeated og:image is read as a gallery: Discord
  draws them side by side, each cropped to a sliver, which is a worse preview
  than the single card it replaced. Dimensions are declared so a scraper that
  cannot fetch the file still reserves the right space, and so X renders the
  large card instead of a small square crop. --}}
<meta property="og:image" content="{{ socialCard.url }}">
<meta property="og:image:type" content="{{ socialCard.type }}">
<meta property="og:image:width" content="{{ socialCard.width }}">
<meta property="og:image:height" content="{{ socialCard.height }}">
<meta property="og:image:alt" content="{{ socialCardAlt }}">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ seoDescription }}">
<meta name="twitter:image" content="{{ socialCard.url }}">
<meta name="twitter:image:alt" content="{{ socialCardAlt }}">

@if (typeof articleMeta !== 'undefined' && articleMeta)
  <meta property="article:published_time" content="{{ articleMeta.published }}">
  <meta property="article:author" content="{{ articleMeta.author }}">
@endif

@if (typeof productMeta !== 'undefined' && productMeta)
  <meta property="product:price:amount" content="{{ productMeta.price }}">
  <meta property="product:price:currency" content="EUR">
  <meta property="product:availability" content="{{ productMeta.availability }}">
@endif

{{-- The brand's own mark, carrying its own `prefers-color-scheme` rule so the
  same file reads on a light and a dark browser tab. No apple-touch-icon: a
  PNG fallback that does not exist is a 404 on every iOS visit, and the SVG
  covers every browser that renders a tab icon at all. --}}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="manifest" href="/site.webmanifest">

{{-- Geist for everything, Geist Mono for prices, sizes and SKUs. Preconnect
  so the hero paints without waiting on the font round trip. --}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap">

{{-- Product images come from the store's own CDN. Warming the connection
  here saves a handshake on the first card that paints. --}}
<link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

<link rel="stylesheet" href="/assets/styles/rappid.css">

@if (typeof jsonLd !== 'undefined' && jsonLd)
  <script type="application/ld+json">{!! jsonLd !!}</script>
@endif

<script>
  /*
   * Theme, resolved before first paint so the page never flashes the wrong
   * one. A saved choice wins over the operating system preference; only a
   * visitor who has never chosen gets the OS answer.
   */
  ;(function () {
    var saved = ''
    try { saved = localStorage.getItem('rappid-theme') || '' }
    catch {}

    var prefersDark = false
    try { prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches }
    catch {}

    var theme = (saved === 'light' || saved === 'dark') ? saved : (prefersDark ? 'dark' : 'light')
    document.documentElement.setAttribute('data-theme', theme)

    window.rappidTheme = function () {
      var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
      try { localStorage.setItem('rappid-theme', next) }
      catch {}
      document.documentElement.setAttribute('data-theme', next)
      document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
        b.setAttribute('aria-label', next === 'dark' ? 'switch to light mode' : 'switch to dark mode')
      })
    }
  })()
</script>

<script>
  /*
   * Market, resolved before first paint for the same reason as the theme:
   * every price is already in the HTML in all three currencies and CSS picks
   * one off this attribute, so setting it late would flash the wrong money.
   */
  ;(function () {
    var allowed = ['de', 'gb', 'us']
    var saved = ''
    try { saved = localStorage.getItem('rappid-market') || '' }
    catch {}

    var market = allowed.indexOf(saved) !== -1 ? saved : 'de'
    document.documentElement.setAttribute('data-market', market)

    document.addEventListener('click', function (event) {
      var button = event.target.closest ? event.target.closest('[data-market-pick]') : null
      if (!button) return
      var next = button.getAttribute('data-market-pick')
      if (allowed.indexOf(next) === -1) return
      try { localStorage.setItem('rappid-market', next) }
      catch {}
      document.documentElement.setAttribute('data-market', next)
      // Prices in the HTML swap via CSS; the bag computes its totals in JS
      // and has to be told.
      document.dispatchEvent(new CustomEvent('rappid:market', { detail: next }))
    })
  })()
</script>
