<script server>
import { brand } from '../data/site'

const pageTitle = 'contact - rappid.'
const pageDescription = 'Reach rappid. about an order, a return, sizing or anything else.'
const canonicalPath = '/contact'

/*
 * Routed rather than pooled: an order question and a wholesale question want
 * different answers, and saying where each goes saves a round trip.
 */
const routes = [
  {
    title: 'an order',
    body: 'Where it is, changing an address, something missing from the parcel.',
    action: 'info@rappid.run',
    href: 'mailto:info@rappid.run?subject=Order',
  },
  {
    title: 'a return',
    body: 'Start it in the portal first. It is faster than email and issues the label.',
    action: 'open the returns portal',
    href: brand.returnsPortal,
    external: true,
  },
  {
    title: 'sizing',
    body: 'Ask for the flat measurements of a piece and your usual size, and you will get them back.',
    action: 'info@rappid.run',
    href: 'mailto:info@rappid.run?subject=Sizing',
  },
]

const social = [
  { label: 'instagram', handle: '@rappid.run', href: 'https://www.instagram.com/rappid.run/' },
  { label: 'youtube', handle: '@kimgottwald', href: 'https://www.youtube.com/@kimgottwald' },
]
</script>
