            </div>
          @endforeach
          <a class="w-[62vw] sm:w-[36vw] lg:w-[23vw] xl:w-[19vw] shrink-0 flex flex-col justify-center items-start border rule px-6 py-8 hover:opacity-70 transition-opacity" href="/collections/all-products">
            <p class="text-2xl tracking-tight">the full range</p>
            <p class="mt-2 text-sm muted">{{ products.length }} pieces, every size we hold.</p>
            <span class="mt-6 text-sm ink underlink">browse everything</span>
          </a>
        </div>
      </section>

      {{-- 4. Categories, as three tall frames. Portrait crops of real race
        photography, not three identical squares of folded clothing. --}}
      <section class="pb-14 lg:pb-20" data-reveal>
        <div class="max-w-[1500px] mx-auto px-5 lg:px-8">
          <div class="grid gap-4 sm:gap-6 sm:grid-cols-3">
            @foreach(categories as category)
              <a class="tile group block reveal-item" href="{{ category.href }}">
                <div class="tile-media relative aspect-[3/4]">
                  <img
                    class="absolute inset-0 w-full h-full object-cover"
                    src="{{ at(category.shot, 700) }}"
                    alt="{{ category.shot.alt }}"
                    width="700"
                    height="933"
                    loading="lazy"
                    decoding="async"
                  >
                </div>
                <div class="flex items-baseline justify-between gap-4 mt-3">
                  <p class="text-2xl tracking-tight ink">{{ category.title }}</p>
                  <p class="text-sm mono muted shrink-0">{{ category.count }} pieces</p>
                </div>
              </a>
            @endforeach
          </div>
        </div>
      </section>

      {{-- 5. Why the brand exists. The old site printed this as a wall of
        centred text; here the photograph carries half of it and the numbers
        underneath are the proof. --}}
      <section class="ink-panel" data-reveal>
        <div class="max-w-[1500px] mx-auto grid lg:grid-cols-12 gap-0">
          <div class="lg:col-span-5 reveal-item">
            <div class="relative aspect-[4/5] lg:h-full lg:aspect-auto overflow-hidden">
              <img
                class="absolute inset-0 w-full h-full object-cover"
                src="{{ at(shots.goOneMore, 900) }}"
                alt="{{ shots.goOneMore.alt }}"
                width="900"
                height="1200"
                loading="lazy"
                decoding="async"
              >
            </div>
          </div>

          <div class="lg:col-span-7 px-5 lg:px-14 py-12 lg:py-20 flex flex-col justify-center reveal-item">
            <h2 class="text-3xl sm:text-4xl lg:text-5xl tracking-[-0.025em] leading-[1.05] max-w-[20ch]">
              {{ brand.tagline }}.
            </h2>
            <p class="mt-6 text-base sm:text-lg panel-muted max-w-[58ch] leading-relaxed">
              rappid. started in 2023 with two people, a textile studio and no visibility at all. The visibility came from running: city to city through Euro 2024, the length of Germany on foot, then 56 hours and 382 kilometres in Texas heat.
            </p>
            <p class="mt-4 text-base panel-muted max-w-[58ch] leading-relaxed">
              The gear came from the same place. Kim raced the whole of Texas in rappid. kit, and still does, because the fastest way to find a seam that fails at hour 40 is to be wearing it at hour 40.
            </p>

            <dl class="grid grid-cols-3 gap-6 mt-10 pt-8 border-t panel-rule max-w-2xl">
              <div>
                <dt class="text-xs mono uppercase tracking-[0.14em] panel-muted">longest race</dt>
                <dd class="mt-2 text-3xl lg:text-4xl mono tracking-tight">67<span class="text-base panel-muted ml-1">h</span></dd>
              </div>
              <div>
                <dt class="text-xs mono uppercase tracking-[0.14em] panel-muted">across germany</dt>
                <dd class="mt-2 text-3xl lg:text-4xl mono tracking-tight">1160<span class="text-base panel-muted ml-1">km</span></dd>
              </div>
              <div>
                <dt class="text-xs mono uppercase tracking-[0.14em] panel-muted">founded</dt>
                <dd class="mt-2 text-3xl lg:text-4xl mono tracking-tight">{{ brand.founded }}</dd>
              </div>
            </dl>

            <a class="btn btn-on-panel mt-10 self-start" href="/stories/the-story-behind-rappid">read the full story</a>
          </div>
        </div>
      </section>

      {{-- 6. Stories. One lead piece at full weight and two beside it, so the
        section reads as a journal rather than three equal teasers. --}}
      <section class="py-14 lg:py-20" data-reveal>
        <div class="max-w-[1500px] mx-auto px-5 lg:px-8">
          <div class="flex items-end justify-between gap-6 mb-8 reveal-item">
            <div>
              <p class="text-xs mono uppercase tracking-[0.16em] faint">stories</p>
              <h2 class="mt-2 text-3xl sm:text-4xl tracking-[-0.02em]">from the runs.</h2>
            </div>
            <a class="text-sm ink underlink shrink-0 pb-1" href="/stories">all stories</a>
          </div>

          <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
            <a class="lg:col-span-7 tile group block reveal-item" href="/stories/{{ lead.slug }}">
              <div class="tile-media relative aspect-[16/10]">
                <img
                  class="absolute inset-0 w-full h-full object-cover"
                  src="{{ storyImage(lead, 1000) }}"
                  alt="{{ lead.imageAlt }}"
                  width="1000"
                  height="625"
                  loading="lazy"
                  decoding="async"
                >
              </div>
              <p class="mt-5 text-xs mono uppercase tracking-[0.14em] faint">{{ storyDate(lead.date) }} <span class="mx-1.5" aria-hidden="true">/</span> {{ readMinutes(lead) }} min</p>
              <h3 class="mt-2 text-2xl sm:text-3xl tracking-[-0.02em] leading-snug max-w-[24ch]">{{ lead.title }}</h3>
              <p class="mt-3 text-sm muted max-w-[56ch]">{{ lead.excerpt }}</p>
            </a>

            <div class="lg:col-span-5 flex flex-col gap-8">
              @foreach(rest as story)
                <a class="tile group flex gap-5 reveal-item" href="/stories/{{ story.slug }}">
                  <div class="tile-media relative w-28 sm:w-36 shrink-0 aspect-[3/4]">
                    <img
                      class="absolute inset-0 w-full h-full object-cover"
                      src="{{ storyImage(story, 320) }}"
                      alt="{{ story.imageAlt }}"
                      width="288"
                      height="384"
                      loading="lazy"
                      decoding="async"
                    >
                  </div>
                  <div class="min-w-0">
                    <p class="text-xs mono uppercase tracking-[0.14em] faint">{{ storyDate(story.date) }}</p>
                    <h3 class="mt-2 text-lg sm:text-xl tracking-[-0.01em] leading-snug">{{ story.title }}</h3>
                    <p class="mt-2 text-sm muted line-clamp-3">{{ story.excerpt }}</p>
                  </div>
                </a>
              @endforeach
            </div>
          </div>
        </div>
      </section>

      {{-- 7. The race the brand actually runs. A real sign-up, not a slogan. --}}
      <section class="border-y rule surface-sunken" data-reveal>
        <div class="max-w-[1500px] mx-auto px-5 lg:px-8 py-14 lg:py-20 flex flex-col lg:flex-row lg:items-end justify-between gap-8 reveal-item">
          <div>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl tracking-[-0.025em] leading-[1.05] max-w-[18ch]">run the rappid. marathon.</h2>
            <p class="mt-4 text-base muted max-w-[52ch]">Our own race, open to anyone who wants a number on their chest. Registration runs through RaceResult.</p>
          </div>
          <a class="btn btn-solid shrink-0" href="{{ brand.marathonSignup }}" target="_blank" rel="noopener">
            sign up
            <i class="i-hugeicons-arrow-up-right-01 w-4 h-4" aria-hidden="true"></i>
          </a>
        </div>
      </section>

      {{-- 8. The three things people email about, answered before they email. --}}
      <section class="py-14 lg:py-20" data-reveal>
        <div class="max-w-[1500px] mx-auto px-5 lg:px-8 grid gap-8 sm:grid-cols-3 sm:gap-10">
          @foreach(service as item)
            <div class="reveal-item">
              <h3 class="text-lg tracking-tight">{{ item.title }}</h3>
              <p class="mt-2.5 text-sm muted max-w-[38ch] leading-relaxed">{{ item.body }}</p>
              <a class="inline-block mt-4 text-sm ink underlink" href="{{ item.href }}">{{ item.link }}</a>
            </div>
          @endforeach
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
