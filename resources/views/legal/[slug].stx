<script server>
import { policies, policyBySlug } from '../../data/policies'
import { footerLinks } from '../../data/site'

const slug = String(params?.slug ?? '')

/*
 * The privacy-choices page is not one of the store's five published policies:
 * it is the opt-out control the privacy policy points at, so it is written
 * here rather than scraped from a page that does not exist.
 */
const choices = slug === 'privacy-choices'

const policy = choices ? undefined : policyBySlug(slug)
const known = choices || Boolean(policy)

const title = choices ? 'your privacy choices' : (policy?.title ?? 'not found')

const pageTitle = `${title} - rappid.`
const pageDescription = choices
  ? 'Opt out of having your personal information shared or sold.'
  : `The rappid. ${title}.`
const canonicalPath = `/legal/${slug}`
</script>
<!DOCTYPE html>
<html lang="en">
  <head>@include('head')</head>
  <body>
    <SiteNav current="/legal/{{ slug }}" />

    <main id="main" class="max-w-[1100px] mx-auto px-5 lg:px-8 py-12 lg:py-16">
      @if(!known)
        <p class="text-xs mono uppercase tracking-[0.16em] faint">404</p>
        <h1 class="mt-3 text-4xl sm:text-5xl tracking-[-0.025em]">no such page.</h1>
        <p class="mt-4 text-base muted max-w-[46ch]">The legal pages are all listed below.</p>
        <ul class="flex flex-wrap gap-2 mt-8">
          @foreach(footerLinks as link)
            <li><a class="btn btn-outline" href="{{ link.href }}">{{ link.label }}</a></li>
          @endforeach
        </ul>
      @else
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-16">
          {{-- The other policies stay one click away, because someone reading
            the refund policy is often one sentence from wanting the terms. --}}
          <nav class="lg:col-span-3 lg:sticky lg:top-24 lg:self-start" aria-label="legal pages">
            <p class="text-xs mono uppercase tracking-[0.14em] faint mb-4">legal</p>
            <ul class="space-y-2.5">
              @foreach(footerLinks as link)
                @if(link.href.startsWith('/legal/'))
                  <li>
                    <a
                      class="text-sm {{ link.href === '/legal/' + slug ? 'ink' : 'muted' }} hover:ink transition-colors"
                      href="{{ link.href }}"
                      @if(link.href === '/legal/' + slug) aria-current="page" @endif
                    >{{ link.label }}</a>
                  </li>
                @endif
              @endforeach
            </ul>
          </nav>

          <div class="lg:col-span-9">
            <h1 class="text-4xl sm:text-5xl tracking-[-0.03em]">{{ title }}</h1>

            @if(choices)
              <div class="mt-8 prose">
                <p class="text-base ink">
                  rappid. does not sell personal information, and does not share it for cross-context behavioural advertising.
                </p>
                <p class="text-base ink">
                  If you would still like an opt-out recorded against your details, or want to know what is held about you, write to
                  <a class="underlink" href="mailto:info@rappid.run">info@rappid.run</a>
                  from the address you ordered with. Requests are answered inside 30 days.
                </p>
                <p class="text-base ink">
                  Your browser's Global Privacy Control signal is honoured automatically where it is sent, with no request needed. What is collected, and why, is set out in full in the
                  <a class="underlink" href="/legal/privacy">privacy policy</a>.
                </p>
              </div>
            @else
              {{-- Published wording, restyled and not rewritten. Multi-line
                blocks keep their line breaks: in an imprint those breaks are
                the address. --}}
              <div class="mt-8 prose">
                @foreach(policy.blocks as block)
                  @if(block.kind === 'heading')
                    <h2 class="text-xl sm:text-2xl tracking-[-0.015em] ink">{{ block.value }}</h2>
                  @elseif(block.kind === 'list')
                    <ul>
                      @foreach(block.items as item)
                        <li class="text-sm muted">{{ item }}</li>
                      @endforeach
                    </ul>
                  @else
                    <p class="text-sm muted" style="white-space: pre-line">{{ block.value }}</p>
                  @endif
                @endforeach
              </div>
            @endif
          </div>
        </div>
      @endif
    </main>

    <SiteFooter />
  </body>
</html>
