<script server>
import { image } from '../../data/catalog'
import { childrenOf, collectionByHandle, collections, itemsIn, sizesAcross } from '../../data/collections'

const handle = String(params?.handle ?? 'all-products')
const collection = collectionByHandle(handle)

/*
 * Filters live in the URL rather than in client state: a filtered grid is
 * then linkable, survives a reload, works with the back button, and renders
 * without JavaScript. Everything below reads `query` and nothing writes it.
 */
const q = typeof query !== 'undefined' ? query : {}
const activeSize = String(q.size ?? '')
const inStockOnly = String(q.stock ?? '') === 'in'
const sort = ['new', 'price-asc', 'price-desc'].includes(String(q.sort ?? '')) ? String(q.sort) : 'new'

const all = collection ? itemsIn(handle) : []
const sizes = sizesAcross(all)

let items = all
if (activeSize)
  items = items.filter(p => p.variants.some(v => v.size === activeSize && (!inStockOnly || v.available)))
if (inStockOnly)
  items = items.filter(p => p.available)

if (sort === 'price-asc')
  items = [...items].sort((a, b) => a.price - b.price)
if (sort === 'price-desc')
  items = [...items].sort((a, b) => b.price - a.price)

/** Rebuild this page's URL with one filter changed, dropping empty values. */
function withFilter(key: string, value: string): string {
  const next: Record<string, string> = { size: activeSize, stock: inStockOnly ? 'in' : '', sort }
  next[key] = value
  const pairs = Object.entries(next).filter(([k, v]) => v && !(k === 'sort' && v === 'new'))
  return pairs.length ? `/collections/${handle}?${new URLSearchParams(pairs).toString()}` : `/collections/${handle}`
}

const children = collection ? childrenOf(handle) : []
const parent = collection?.parent ? collectionByHandle(collection.parent) : undefined
const siblings = collection?.parent ? childrenOf(collection.parent) : []

const sorts = [
  { key: 'new', label: 'newest' },
  { key: 'price-asc', label: 'price, low to high' },
  { key: 'price-desc', label: 'price, high to low' },
]

const filtered = Boolean(activeSize) || inStockOnly
const cover = all.find(p => p.images.length)?.images[0]

const pageTitle = collection ? `${collection.title} - rappid.` : 'collection not found - rappid.'
const pageDescription = collection ? collection.blurb : 'That collection does not exist.'
const canonicalPath = `/collections/${handle}`
const ogImage = cover ? image(cover.src, 1200) : ''
</script>
<!DOCTYPE html>
<html lang="en">
  <head>@include('head')</head>
  <body>
    <SiteNav current="/collections/{{ handle }}" />

    <main id="main">
      @if(!collection)
        <div class="max-w-[1500px] mx-auto px-5 lg:px-8 py-24 lg:py-32">
          <p class="text-xs mono uppercase tracking-[0.16em] faint">404</p>
          <h1 class="mt-3 text-4xl sm:text-5xl tracking-[-0.025em]">no such collection.</h1>
          <p class="mt-4 text-base muted max-w-[46ch]">The link may be from an old drop. Everything currently in the shop is one click away.</p>
          <div class="flex flex-wrap gap-3 mt-8">
            <a class="btn btn-solid" href="/collections/all-products">browse all products</a>
            <a class="btn btn-outline" href="/drops">see the drops</a>
          </div>
        </div>
      @else
        <div class="max-w-[1500px] mx-auto px-5 lg:px-8">
          <nav class="flex items-center gap-2 pt-6 text-xs mono uppercase tracking-[0.12em] faint" aria-label="breadcrumb">
            <a class="hover:ink transition-colors" href="/">home</a>
            <span aria-hidden="true">/</span>
            @if(parent)
              <a class="hover:ink transition-colors" href="/collections/{{ parent.handle }}">{{ parent.title }}</a>
              <span aria-hidden="true">/</span>
            @endif
            <span class="ink">{{ collection.title }}</span>
          </nav>

          <header class="pt-8 pb-10 border-b rule">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl tracking-[-0.03em] leading-[1.02]">{{ collection.title }}</h1>
            <p class="mt-4 text-base muted max-w-[56ch]">{{ collection.blurb }}</p>
          </header>

          {{-- Sub-collections read as a second row of navigation rather than
            being buried in the menu, so a wide collection can be narrowed
            without going back up a level. --}}
          @if(children.length || siblings.length > 1)
            <nav class="flex flex-wrap gap-2 pt-6" aria-label="sub-collections">
              @if(children.length)
                <span class="btn btn-outline pointer-events-none" style="border-color: var(--line-strong); background: var(--invert-bg); color: var(--invert-ink)">all {{ collection.title }}</span>
                @foreach(children as child)
                  <a class="btn btn-outline" href="/collections/{{ child.handle }}">{{ child.title }}</a>
                @endforeach
              @else
                <a class="btn btn-outline" href="/collections/{{ parent.handle }}">all {{ parent.title }}</a>
                @foreach(siblings as sibling)
                  @if(sibling.handle === handle)
                    <span class="btn" style="background: var(--invert-bg); color: var(--invert-ink); border-color: var(--invert-bg)">{{ sibling.title }}</span>
                  @else
                    <a class="btn btn-outline" href="/collections/{{ sibling.handle }}">{{ sibling.title }}</a>
                  @endif
                @endforeach
              @endif
            </nav>
          @endif

          {{-- Filters. Each control is a link, so the grid state is the URL and
            the whole bar works with JavaScript switched off. --}}
          <div class="flex flex-wrap items-center gap-x-8 gap-y-4 py-6 mt-2 border-b rule">
            @if(sizes.length > 1)
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-xs mono uppercase tracking-[0.14em] faint mr-1">size</span>
                @foreach(sizes as size)
                  <a
                    class="px-2.5 py-1.5 text-xs mono border rule hover:opacity-100 transition-opacity {{ activeSize === size ? 'opacity-100' : 'opacity-55' }}"
                    style="{{ activeSize === size ? 'background: var(--invert-bg); color: var(--invert-ink); border-color: var(--invert-bg)' : '' }}"
                    href="{{ activeSize === size ? withFilter('size', '') : withFilter('size', size) }}"
                    aria-pressed="{{ activeSize === size ? 'true' : 'false' }}"
                  >{{ size }}</a>
                @endforeach
              </div>
            @endif

            <a
              class="flex items-center gap-2 text-xs mono uppercase tracking-[0.14em] {{ inStockOnly ? 'ink' : 'muted' }} hover:ink transition-colors"
              href="{{ inStockOnly ? withFilter('stock', '') : withFilter('stock', 'in') }}"
              aria-pressed="{{ inStockOnly ? 'true' : 'false' }}"
            >
              <span class="w-3.5 h-3.5 border rule-strong flex items-center justify-center shrink-0" aria-hidden="true">
                @if(inStockOnly)
                  <span class="w-2 h-2 accent-bg"></span>
                @endif
              </span>
              in stock only
            </a>

            {{-- Sort options are chips rather than a run of inline links: on a
              phone the long labels wrapped into each other and it stopped
              being obvious where one option ended. --}}
            <div class="flex items-center gap-2 flex-wrap sm:ml-auto">
              <span class="text-xs mono uppercase tracking-[0.14em] faint mr-1">sort</span>
              @foreach(sorts as option)
                <a
                  class="px-2.5 py-1.5 text-xs mono border rule whitespace-nowrap hover:opacity-100 transition-opacity {{ sort === option.key ? 'opacity-100' : 'opacity-55' }}"
                  style="{{ sort === option.key ? 'background: var(--invert-bg); color: var(--invert-ink); border-color: var(--invert-bg)' : '' }}"
                  href="{{ withFilter('sort', option.key) }}"
                  aria-current="{{ sort === option.key ? 'true' : 'false' }}"
                >{{ option.label }}</a>
              @endforeach
            </div>
          </div>

          <div class="flex items-center justify-between gap-4 py-5">
            <p class="text-sm muted">
              <span class="mono ink">{{ items.length }}</span>
              @if(items.length === 1) piece @else pieces @endif
              @if(filtered)
                <span class="faint">of {{ all.length }}</span>
              @endif
            </p>
            @if(filtered)
              <a class="text-sm ink underlink" href="/collections/{{ handle }}">clear filters</a>
            @endif
          </div>

          <div class="pb-16 lg:pb-24">
            <ProductGrid :items="items" />
          </div>
        </div>
      @endif
    </main>

    <SiteFooter />
  </body>
</html>
