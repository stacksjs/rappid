<script server>
import { brand } from '../data/site'

const pageTitle = 'returns - rappid.'
const pageDescription = 'How to send a rappid. order back: the 14-day window, the returns portal, who pays postage and the condition pieces have to be in.'
const canonicalPath = '/returns'

/*
 * Every step below restates the published refund policy in plain English. The
 * binding wording, in German, is on /legal/refunds and is not edited: this
 * page is a summary and says so.
 */
const steps = [
  {
    title: 'you have 14 days',
    body: 'The window runs from the day the parcel reaches you, or whoever you had it delivered to. Telling us inside those 14 days is what matters; the parcel itself can leave later.',
  },
  {
    title: 'start it in the portal',
    body: 'Delivered to Germany, Austria or Switzerland? The returns portal is the required route, and it issues the return label. Anywhere else, email us and organise the shipment yourself.',
  },
  {
    title: 'send it back unworn',
    body: 'Unused, unworn, no signs of wear, in undamaged original packaging. Anything worn beyond checking the fit loses value, and that loss is charged.',
  },
  {
    title: 'you get the money back the way you paid',
    body: 'Refunded to the original payment method, including the standard delivery cost you paid. It can be held until the goods arrive back, or until you show they are on their way.',
  },
]

const address = [
  'rappid. UG (haftungsbeschränkt)',
  'c/o Versandmanufaktur GmbH',
  'Sinterstraße 9',
  '44795 Bochum',
  'Germany',
]
</script>
