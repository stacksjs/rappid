      <p class="mt-4 text-base muted max-w-[60ch] leading-relaxed">
        {{ brand.returnDays }} days to change your mind, on anything that has not been worn. This page is the short version; the binding wording is in the
        <a class="ink underlink" href="/legal/refunds">refund policy</a>.
      </p>

      <a class="btn btn-solid mt-8" href="{{ brand.returnsPortal }}" target="_blank" rel="noopener">
        open the returns portal
        <i class="i-hugeicons-arrow-up-right-01 w-4 h-4" aria-hidden="true"></i>
      </a>

      <ol class="mt-14 border-t rule">
        @foreach(steps as step)
          <li class="grid sm:grid-cols-12 gap-3 sm:gap-8 py-8 border-b rule">
            <h2 class="sm:col-span-5 text-lg tracking-tight ink">{{ step.title }}</h2>
            <p class="sm:col-span-7 text-sm muted leading-relaxed">{{ step.body }}</p>
          </li>
        @endforeach
      </ol>

      <div class="grid sm:grid-cols-2 gap-10 mt-14">
        <section>
          <h2 class="text-xl tracking-tight">who pays the postage</h2>
          <p class="mt-3 text-sm muted leading-relaxed max-w-[42ch]">
            You do, for a change of mind. We do when the piece arrived faulty, damaged or simply wrong, so a mistake at our end never costs you shipping.
          </p>
        </section>

        <section>
          <h2 class="text-xl tracking-tight">what cannot come back</h2>
          <p class="mt-3 text-sm muted leading-relaxed max-w-[42ch]">
            Anything made to your own specification or cut to your personal requirements. Everything in the standard range can.
          </p>
        </section>
      </div>

      <section class="mt-14 pt-10 border-t rule grid sm:grid-cols-2 gap-10">
        <div>
          <h2 class="text-xl tracking-tight">send it to</h2>
          <address class="mt-3 text-sm muted not-italic leading-relaxed">
            @foreach(address as line)
              {{ line }}<br>
            @endforeach
          </address>
          <p class="mt-3 text-xs muted max-w-[40ch]">Inside the DACH region, use the portal instead: it labels the parcel for you.</p>
        </div>

        <div>
          <h2 class="text-xl tracking-tight">portal not working?</h2>
          <p class="mt-3 text-sm muted leading-relaxed max-w-[40ch]">
            Email <a class="ink underlink" href="mailto:info@rappid.run">info@rappid.run</a> before you send anything back and you will get a returns form to put in the parcel.
